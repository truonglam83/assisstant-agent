# Port của NestJS server
PORT=3001

# URL của Frontend (CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_NAME=assistant_db

# Auth — phải khớp với AUTH_SECRET trong web/.env.local
AUTH_SECRET=
ALLOWED_EMAIL=
